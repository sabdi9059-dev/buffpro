# COATPRO environment variables
# Copy this file to ".env" and fill in your real values.
# Vite only exposes variables prefixed with VITE_ to the client bundle.

# Supabase — Project Settings > API
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Optional: default business slug used by the public booking page during local dev
VITE_DEFAULT_BUSINESS_SLUG="demo-detailing"

# -----------------------------------------------------------------------------
# Stripe (payments)
# -----------------------------------------------------------------------------
# Client (browser) — publishable key only. Dashboard > Developers > API keys.
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"

# -----------------------------------------------------------------------------
# SERVER-ONLY secrets (used by the /api functions — never prefixed with VITE_,
# so they are never shipped to the browser bundle).
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_xxx"
# From the webhook endpoint you create in the Stripe dashboard (or `stripe listen`).
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# Supabase service role key (bypasses RLS — server only!).
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Twilio (SMS confirmations, reminders, on-the-way, completion)
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1xxxxxxxxxx"

# SMS cost tracking / budgeting (optional)
SMS_COST_PER_MESSAGE="0.0079"      # estimated USD per segment
SMS_MONTHLY_BUDGET_USD="50"        # set >0 to enable the over-budget alert

# Secures the daily-reminders cron. Vercel sends this as a Bearer token.
CRON_SECRET="generate-a-long-random-string"

# Secures POST /api/notify (event-driven SMS). Send as `Authorization: Bearer`.
INTERNAL_API_SECRET="generate-a-long-random-string"

# Base URL used to build the review link in the completion SMS.
APP_URL="https://coatpro.example.com"

# Optional defaults for the "on the way" SMS when not passed per-request.
DEFAULT_VEHICLE_COLOR="white"
DEFAULT_VEHICLE_PLATE="COATPRO"
