# COATPRO environment variables
# Copy this file to ".env" and fill in your real values.
# Vite only exposes variables prefixed with VITE_ to the client bundle.

# Supabase — Project Settings > API
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Optional: default business slug used by the public booking page during local dev
VITE_DEFAULT_BUSINESS_SLUG="demo-detailing"

# -----------------------------------------------------------------------------
# Stripe (payments)
# -----------------------------------------------------------------------------
# Client (browser) — publishable key only. Dashboard > Developers > API keys.
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"

# -----------------------------------------------------------------------------
# SERVER-ONLY secrets (used by the /api functions — never prefixed with VITE_,
# so they are never shipped to the browser bundle).
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_xxx"
# From the webhook endpoint you create in the Stripe dashboard (or `stripe listen`).
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# Supabase service role key (bypasses RLS — server only!).
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Twilio (SMS confirmations)
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1xxxxxxxxxx"
